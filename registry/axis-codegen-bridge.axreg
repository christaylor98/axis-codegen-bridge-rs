// ── Async / IPC primitives (channels.rs — BRIDGE_ASYNC_PRIMITIVES_V1) ─────────
// event_subscribe / channel_send / wait. `wait` takes its handler in a Fn
// callee slot (invoked synchronously in-frame — CLOSURE_RULE_HARD) and always
// delivers a List (WAIT_ALWAYS_LIST). Channel names are static (CHANNELS_STATIC).

// ───────────── BRIDGE_FOREIGN_FN_FNREF_M1 — Phase 1 (P0) ─────────────

// ───────────── BRIDGE_FOREIGN_FN_FNREF_M1 — Phase 2 (P1) ─────────────

// ───────────── BRIDGE_FOREIGN_FN_FNREF_M1 — Phase 3 (text helpers) ─────────────

// ───────────── BRIDGE_VALUE_COERCION_V1 — tag-dispatch primitives ─────────────
//
// Two tag-dispatching HOFs. Identity-keyed by sha256(name). Each takes a Value
// plus one converter Fn-ref per numeric variant in positional tag order
// (arg1=Int, arg2=Dec, arg3=Float). Non-numeric Value reaching a dispatcher
// is a runtime panic (EXHAUSTIVE_OR_PANIC). The six converters
// (int_to_dec / dec_id / float_to_dec / int_to_float / dec_to_float / float_id)
// are lang-level — declared in registry/axis.axreg.

// ───────────── AXBI_PARSE_V1 — Core IR 0.5 binary format parser ─────────────
//
// One bridge function. Takes a ValueList of raw .axbi bytes (each element Int
// 0..=255). Returns a fully-structured Value tree that M1 can navigate with
// standard list/tuple bridge functions (no opaque handles, no extra accessors).
//
// Returned shape:
//   Value::Tuple([
//     pool:  List<Tuple<Str(def_hash_hex), List<Int(byte)>>>,
//     nodes: List<Ctor "CCall"|"CIf"|"CDeterminate">,
//   ])
// NodeRef args/edges: Tuple<Str("node"|"pool"), Int(index)>
//
// Hard-fails (UNKNOWN gate) on bad magic, wrong version, truncated data,
// non-minimal varint, forward edge, or out-of-range pool index.
// Impl: axis-codegen-bridge-rs/src/runtime/axbi.rs

// ───────────── BRIDGE_HASH_PRIMITIVE_M1 — resolves hld:axverity-hash-dependency ─
//
// content_hash(bytes: ValueList) -> Text
//   SHA-256 of the byte sequence, returned as "sha256:{64-hex}" (71 chars).
//
// hash256_parse(text: Text) -> Text
//   Validates "sha256:" + 64 lowercase hex chars. Returns the input verbatim on
//   match; panics on any other shape. A 63-char hex portion panics (axVerity
//   criterion).
//
// Impl: axis-codegen-bridge-rs/src/runtime/hash.rs
// Identities are sha256(name_utf8) — DO NOT recompute.

// AXVERITY_INDEXER_THREADING_V1 — index_build_batch(batch: Value) -> Value
//   The wait() handler for the "index-frame" channel. For each drained seal
//   descriptor Tuple(block_seq, flush_dir, byte_len, idx_cell), reads the
//   durable flushed .bin READ-ONLY, computes the Merkle hash (== content_hash's
//   sha2 digest), writes <flush_dir>/index/block-<seq>.idx (succinct = stub),
//   and flips the per-block index-status AtomicI64 cell 0->1 in one CAS.
//   Impl: axis-codegen-bridge-rs/src/runtime/indexer.rs
//   Identity is sha256(name_utf8) — DO NOT recompute.

// idxseg_lookup(dir: Text, block_seq: Int) -> Text — T2 read side: scan the
// dir's iseg-* segments (sorted-name order), return the block's LAST valid
// entry "<sha256:hex>\t<len>\t<succinct>" or "" (never indexed / all torn).

// index_rebuild_dir(dir: Text) -> Int — T2 storm-recovery: re-index every
// block-*.bin in dir in ONE process / ONE segment append. Idempotent.

// ───────────── BRIDGE_BYTES_IO_M1 — resolves hld:axverity-text-to-bytes-dependency ─
//
// text_to_bytes(text: Text) -> Bytes
//   UTF-8 encode the Text and return as an opaque Bytes blob.
//
// fs_write_bytes(path: Text, content: Bytes) -> Unit
//   Durable write — temp + fsync + rename + fsync parent dir. Panics on any
//   OS error.
//
// fs_read_bytes(path: Text) -> Bytes
//   Read the whole file as a Bytes blob. Panics on any OS error.
//
// Impl: axis-codegen-bridge-rs/src/runtime/bytes_io.rs
// Identities are sha256(name_utf8) — DO NOT recompute.

// BRIDGE_SEEK_V1 (spike:axverity-spike1) — range read via seek; O(len) not
// O(file-size). Over-EOF clamps to available bytes (short read). Thin: raw
// bytes only, no framing/hashing. identity = sha256("fs_read_range").

// BRIDGE_CDC_V1 (AXVERITY_LANDING_B_BLOB_CHUNKER) — standalone FastCDC
// content-defined chunker. One "<off>\t<len>\tsha256:<hex>" line per chunk;
// streams a bounded window (no RAM spike). Scan is bridge-load-bearing
// (per-byte over multi-MB — impossible in M1). identity = sha256("chunk_file").

// BRIDGE_LOGBUF_V1 (spike:axverity-spike1) — thin Rust-owned durable append
// buffer. append = memcpy into a Vec; sync = one write_all + one fsync + clear.
// THIN: bridge owns buffer+tail+fsync only; M1 owns framing/hashing/commit.
// logbuf_append returns the record's logical start offset (-1 reserved as a
// future buffer-full/rotation signal, not produced in this spike).

// ───────────── BRIDGE_AXVERITY_BLOCKING_FNS_v0.1 — unblocks turn:axverity:0001 ─
//
// bytes_hash(Bytes) -> Text
//   SHA-256 of a Bytes blob. Returns "sha256:{64-hex}". Same crypto as
//   content_hash but consumes Value::Bytes directly (no list coercion).
//
// fs_mkdir_p(Text) -> Unit
//   Recursive idempotent directory create (std::fs::create_dir_all). Panics
//   on any OS error.
//
// Impl: axis-codegen-bridge-rs/src/runtime/bytes_io.rs
// Identities are sha256(name_utf8) per §5b bootstrap rule.

// ───────────── BRIDGE_BYTES_TO_TEXT — resolves hld:m1-bytes-to-text ─
//
// bytes_to_text(Bytes) -> Text
//   Checked UTF-8 decode. Returns the decoded Text. Panics on invalid UTF-8.
//   Inverse of text_to_bytes for valid UTF-8 inputs.
//
// Impl: axis-codegen-bridge-rs/src/runtime/bytes_io.rs
// Identity = sha256(name_utf8) per §5b bootstrap rule.

// ── Byte codec (bytes_codec.rs — BRIDGE_BYTE_CODEC_V1) ────────────────────────
// AXLANG_TURN_0002_BYTE_CODEC_PRIMITIVES — unblocks turn:axverity:0017 (Postgres
// wire protocol). Pure leaf fns for assembling/parsing binary wire frames as raw
// Bytes without routing binary framing through UTF-8-validated Text.
//
// bytes_concat(Bytes, Bytes) -> Bytes   append b to a (binary; fold in M1 for n-ary)
// bytes_len(Bytes) -> Int               blob length in bytes
// bytes_slice(Bytes, Int, Int) -> Bytes half-open [start,end); STRICT bounds, panics OOB
//                                       (byte_at composes as bytes_slice(b, i, i+1))
// int16_be_encode(Int) -> Bytes         accepts -32768..=65535, emits 2 BE bytes
// int16_be_decode(Bytes) -> Int         exactly 2 bytes, signed two's-complement
// int32_be_encode(Int) -> Bytes         accepts -2147483648..=4294967295, 4 BE bytes
// int32_be_decode(Bytes) -> Int         exactly 4 bytes, signed two's-complement
//
// Impl: axis-codegen-bridge-rs/src/runtime/bytes_codec.rs
// Identities are sha256(name_utf8) per §5b bootstrap rule — DO NOT recompute.

// ── TCP sockets (net.rs — BRIDGE_TCP_SOCKET_V1) ───────────────────────────────
// gap:axverity-postgres-wire-needs-socket-primitive. Synchronous blocking leaf
// fns; no async/channels coupling. tcp_listen returns Value::Tuple([handle,
// port]) — destructure with tuple_field (slot 0 = handle, slot 1 = bound port).
// Identity = sha256(name_utf8) per §5b bootstrap rule.

