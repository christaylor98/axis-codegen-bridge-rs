registry axis-codegen-bridge 0.1

type Unit = prim unit
type Int  = prim int
type Text = prim text
type Bool = prim bool
type Dec   = prim dec
type Float = prim float
type Bytes = prim bytes
type Value = sum [ AsUnit(Unit) | AsBool(Bool) | AsInt(Int) | AsText(Text) ]
type TextList = list Text
type ValueList = list Value
// Fn-refs travel through the bridge as Value-tagged identity hashes; the
// registry parser does not recognise `prim fn`, so we declare Fn as an alias
// for the value primitive. Verifier semantics for HOF slots are unchanged.
type Fn = prim value

// ── Arithmetic (arith.rs) ─────────────────────────────────────────────────────

// ── Comparison (arith.rs) ─────────────────────────────────────────────────────

// Dec/Float ordered comparisons — the Dec/Float-typed counterparts of the
// int_ lt/lte/gt/gte family. Type-monomorphic (mixed operands panic). Float
// follows IEEE-754: any comparison with NaN is false. Identity = sha256(name).

// Typed equality leaves. int_eq/dec_eq/float_eq are the Int/Dec/Float-typed
// counterparts of str_eq (Text); value_eq/__eq__ remain the generic fallback.
// int_eq and dec_eq/float_eq were implemented + wired in the emit symbol_map but
// were previously undeclared here — added so §5b consumers resolve them through
// the canonical registry. Identity = sha256(name_utf8) per §5b bootstrap rule.

// ── Boolean (bool_ops.rs) ─────────────────────────────────────────────────────

// ── String (str_ops.rs) ───────────────────────────────────────────────────────

// text_eq is the axis-canonical alias of str_eq (identical runtime); wired in the
// emit symbol_map but previously undeclared here. Identity = sha256("text_eq").

// Text lexicographic ordering (by Unicode scalar / UTF-8 byte order). text_lt
// was wired in the emit symbol_map but previously undeclared here; lte/gt/gte
// complete the family to match int_ lt/lte/gt/gte. Identity = sha256(name).

// str_* aliases of the text_* ordered comparisons (identical runtime), the
// surface-name pairing that mirrors str_eq/text_eq. Identity = sha256(name).

// ── List (list.rs) ────────────────────────────────────────────────────────────

// ── Tuple / Constructor (tuple.rs) ────────────────────────────────────────────

// ── Option (option.rs) ────────────────────────────────────────────────────────

