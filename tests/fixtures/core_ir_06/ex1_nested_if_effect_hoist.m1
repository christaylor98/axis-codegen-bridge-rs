// Core IR 0.6 worked example 1 (axis-core-ir-0.6.md): the write is in the then-arm of `if bool_and(f, g)` and
// runs only when that arm is selected. z = 0, so g is false: prints 0. `bool_and(f, h)` is written twice: the
// one in _x's else-arm is in a closed block when _y is written, so _y gets its own.
fn main() -> Unit {
  let p = tuple_field(mem_reserve_raw(Int(64)), Int(0))
  let z = mem_read_int_raw(p, Int(0))
  let f = int_eq(z, Int(0))
  let g = int_eq(z, Int(1))
  let h = int_lt(z, Int(5))
  let _x = if bool_and(f, g) { mem_write_int_raw(p, Int(8), Int(1)) }
           else { if bool_and(f, h) { io_print(Text("")) }
                  else { io_print(Text("")) } }
  let _y = if bool_and(f, h) { io_print(Text("")) } else { io_print(Text("")) }
  io_println(int_to_str(mem_read_int_raw(p, Int(8))))
}
