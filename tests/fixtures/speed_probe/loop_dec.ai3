fn d_more(st: Value(Int, Dec, Int)) -> Bool {
  return int_lt(value_to_int(ctor_field(st, Int(0))), value_to_int(ctor_field(st, Int(2))))
}

fn d_step(st: Value(Int, Dec, Int)) -> Value(Int, Dec, Int) {
  let i = value_to_int(ctor_field(st, Int(0)))
  let acc = value_to_dec(ctor_field(st, Int(1)))
  return value_make(int_add(i, Int(1)), dec_add(acc, int_to_dec(int_mod(i, Int(7)))), value_to_int(ctor_field(st, Int(2))))
}

fn main() -> Unit {
  let n = str_to_int(argv_or(Int(1), Text("0")))
  let r = loop_while(value_make(Int(0), str_to_dec(Text("0")), n), d_more, d_step, int_add(n, Int(1)))
  return io_print(dec_to_text(value_to_dec(ctor_field(r, Int(1)))))
}
